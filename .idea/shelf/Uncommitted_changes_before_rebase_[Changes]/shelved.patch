     width: 100%;\r\n            }\r\n\r\n            .subject-header h1 {\r\n                font-size: 1.5rem !important;\r\n            }\r\n\r\n            .subject-header p {\r\n                font-size: 0.9rem !important;\r\n            }\r\n        }\r\n    </style>\r\n\r\n    <script>\r\n        // Pagination variables\r\n        let currentPage = 1;\r\n        const videosPerPage = 10;\r\n        let allVideos = [];\r\n\r\n        // Initialize pagination on page load\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            allVideos = Array.from(document.querySelectorAll('.video-lecture-item'));\r\n            showPage(1);\r\n        });\r\n\r\n        function showPage(page) {\r\n            currentPage = page;\r\n            const startIndex = (page - 1) * videosPerPage;\r\n            const endIndex = startIndex + videosPerPage;\r\n\r\n            // Hide all videos\r\n            allVideos.forEach(video => video.style.display = 'none');\r\n\r\n            // Show only videos for current page\r\n            allVideos.slice(startIndex, endIndex).forEach(video => video.style.display = 'block');\r\n\r\n            // Update pagination controls\r\n            updatePaginationControls();\r\n\r\n            // Scroll to top of video section\r\n            document.querySelector('#videoContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });\r\n        }\r\n\r\n        function updatePaginationControls() {\r\n            const totalPages = Math.ceil(allVideos.length / videosPerPage);\r\n            const prevBtn = document.getElementById('prevBtn');\r\n            const nextBtn = document.getElementById('nextBtn');\r\n            const pageNumbers = document.getElementById('pageNumbers');\r\n\r\n            // Update prev/next button states\r\n            prevBtn.disabled = currentPage === 1;\r\n            prevBtn.style.opacity = currentPage === 1 ? '0.5' : '1';\r\n            prevBtn.style.cursor = currentPage === 1 ? 'not-allowed' : 'pointer';\r\n\r\n            nextBtn.disabled = currentPage === totalPages;\r\n            nextBtn.style.opacity = currentPage === totalPages ? '0.5' : '1';\r\n            nextBtn.style.cursor = currentPage === totalPages ? 'not-allowed' : 'pointer';\r\n\r\n            // Generate page numbers\r\n            pageNumbers.innerHTML = '';\r\n            for (let i = 1; i <= totalPages; i++) {\r\n                const pageBtn = document.createElement('button');\r\n                pageBtn.textContent = i;\r\n                pageBtn.onclick = () => showPage(i);\r\n                pageBtn.style.cssText = `\r\n                    padding: 0.5rem 0.8rem;\r\n                    border: none;\r\n                    border-radius: 6px;\r\n                    cursor: pointer;\r\n                    font-size: 0.9rem;\r\n                    background: ${i === currentPage ? '#667eea' : '#f0f0f0'};\r\n                    color: ${i === currentPage ? 'white' : '#333'};\r\n                `;\r\n                pageNumbers.appendChild(pageBtn);\r\n            }\r\n        }\r\n\r\n        function changePage(direction) {\r\n            const totalPages = Math.ceil(allVideos.length / videosPerPage);\r\n            if (direction === 'prev' && currentPage > 1) {\r\n                showPage(currentPage - 1);\r\n            } else if (direction === 'next' && currentPage < totalPages) {\r\n                showPage(currentPage + 1);\r\n            }\r\n        }\r\n\r\n        function toggleVideo(videoId) {\r\n            const videoContainer = document.getElementById(videoId);\r\n            const button = event.target;\r\n            \r\n            // Close all other videos first\r\n            const allVideoContainers = document.querySelectorAll('.video-container');\r\n            allVideoContainers.forEach(video => {\r\n                if (video.id !== videoId) {\r\n                    video.style.display = 'none';\r\n                    // Reset all buttons to \"Watch\"\r\n                    const otherButtons = document.querySelectorAll('.video-lecture-item button');\r\n                    otherButtons.forEach(btn => {\r\n                        if (btn !== button) {\r\n                            btn.innerHTML = '▶ Watch';\r\n                            btn.style.background = '#667eea';\r\n                        }\r\n                    });\r\n                }\r\n            });\r\n            \r\n            // Toggle current video\r\n            if (videoContainer.style.display === 'none' || videoContainer.style.display === '') {\r\n                videoContainer.style.display = 'block';\r\n                button.innerHTML = '✕ Close Video';\r\n                button.style.background = '#e74c3c';\r\n                \r\n                // Scroll to video smoothly\r\n                setTimeout(() => {\r\n                    videoContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\r\n                }, 100);\r\n            } else {\r\n                videoContainer.style.display = 'none';\r\n                button.innerHTML = '▶ Watch';\r\n                button.style.background = '#667eea';\r\n            }\r\n        }\r\n    </script>\r\n</body>\r\n</html>\r\n
