                <h4>Core Subjects</h4>\r\n                            <ul>\r\n                                <li>Mathematics</li>\r\n                                <li>English Language</li>\r\n                                <li>General Studies</li>\r\n                            </ul>\r\n                        </div>\r\n                        <div style=\"background: #ecf0f1; padding: 1rem; border-radius: 8px;\">\r\n                            <h4>Sciences</h4>\r\n                            <ul>\r\n                                <li>Physics</li>\r\n                                <li>Chemistry</li>\r\n                                <li>Biology</li>\r\n                            </ul>\r\n                        </div>\r\n                        <div style=\"background: #ecf0f1; padding: 1rem; border-radius: 8px;\">\r\n                            <h4>Arts & Social Sciences</h4>\r\n                            <ul>\r\n                                <li>Economics</li>\r\n                                <li>Government</li>\r\n                                <li>Literature</li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </section>\r\n\r\n                <section style=\"margin-top: 2rem;\">\r\n                    <h2>Why Practice with Our Platform?</h2>\r\n                    <ul style=\"line-height: 2;\">\r\n                        <li>✅ Authentic NECO-style questions</li>\r\n                        <li>✅ Timed practice tests</li>\r\n                        <li>✅ Instant feedback and explanations</li>\r\n                        <li>✅ Track your progress</li>\r\n                        <li>✅ Identify weak areas</li>\r\n                        <li>✅ Exam-like interface</li>\r\n                    </ul>\r\n                </section>\r\n\r\n                <section style=\"margin-top: 2rem;\">\r\n                    <h2>Preparation Tips</h2>\r\n                    <ol style=\"line-height: 2